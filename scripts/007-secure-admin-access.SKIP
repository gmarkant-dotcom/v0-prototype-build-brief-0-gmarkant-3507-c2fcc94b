-- =====================================================================
-- .SKIP - DO NOT RUN THIS FILE. Renamed from 007-secure-admin-access.sql
-- on 2026-08-17, following the scripts/029-msa-payments.SKIP convention.
--
-- WHY: line 49 below is a full CREATE OR REPLACE FUNCTION
-- public.handle_new_user(). Running it silently reverts migration 078,
-- which is applied and verified in production, and reinstates two things
-- 078 deliberately removed:
--   * the hardcoded comparison of NEW.email against 'greg@withligament.com'
--     as the way is_admin is decided (lines 45-46 and 63);
--   * a handle_new_user that never reads raw_user_meta_data->>'role', so
--     every signup lands with the wrong role again.
-- It also declares SECURITY DEFINER with no SET search_path, undoing 078's
-- search_path pin, and its INSERT writes is_admin and is_paid, which 078
-- removed so that new accounts land unpaid and are granted deliberately.
--
-- Migration 079 extends the same function again. Anything that overwrites
-- it after 079 also destroys the organization and owner-membership insert,
-- which locks every subsequent signup out of its own data.
--
-- The column additions at the top (is_admin, is_paid) are long since live
-- and are ALTER TABLE ... ADD COLUMN IF NOT EXISTS, so they are harmless
-- on their own. That is not a reason to run the file.
--
-- Nothing in the codebase references this file. Grepped repo-wide before
-- renaming: the only hits were in dated documents under docs/.
-- =====================================================================

-- Add is_admin and is_paid columns to profiles table
-- These columns control admin access and paid subscription status

-- Add the columns if they don't exist
ALTER TABLE public.profiles 
ADD COLUMN IF NOT EXISTS is_admin BOOLEAN DEFAULT false;

ALTER TABLE public.profiles 
ADD COLUMN IF NOT EXISTS is_paid BOOLEAN DEFAULT false;

-- Reset all admin flags to false
UPDATE public.profiles 
SET is_admin = false;

-- Set the owner as admin (if the account exists)
UPDATE public.profiles 
SET is_admin = true 
WHERE email = 'greg@withligament.com';

-- Update the handle_new_user function to include the new columns
CREATE OR REPLACE FUNCTION public.handle_new_user()
RETURNS TRIGGER
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = public
AS $$
BEGIN
  INSERT INTO public.profiles (id, email, full_name, company_name, role, is_admin, is_paid)
  VALUES (
    NEW.id,
    NEW.email,
    COALESCE(NEW.raw_user_meta_data ->> 'full_name', NULL),
    COALESCE(NEW.raw_user_meta_data ->> 'company_name', NULL),
    COALESCE(NEW.raw_user_meta_data ->> 'role', 'partner'),
    CASE WHEN NEW.email = 'greg@withligament.com' THEN true ELSE false END,
    false
  )
  ON CONFLICT (id) DO NOTHING;
  
  RETURN NEW;
END;
$$;
